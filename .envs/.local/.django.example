# ------------------------------------------------------------------------------
# StayEase Local Django Environment Configuration Template
# Copy this file to '.envs/.local/.django' and fill in your local values.
# ------------------------------------------------------------------------------

# General
# ------------------------------------------------------------------------------
USE_DOCKER=yes
IPYTHONDIR=/app/.ipython

# Django Secret Key (optional for local, uses fallback if not set)
# ------------------------------------------------------------------------------
# DJANGO_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET

# Email (Gmail SMTP or Console)
# ------------------------------------------------------------------------------
# Leave empty to print emails to the Docker container console stdout.
# To send real emails via Gmail SMTP, provide your Gmail address and 16-character App Password.
# Generate App Password at: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DJANGO_DEFAULT_FROM_EMAIL=StayEase <noreply@example.com>

# Public Canonical URL
# ------------------------------------------------------------------------------
STAYEASE_PUBLIC_URL=http://localhost:8000
SITE_URL=http://localhost:8000
